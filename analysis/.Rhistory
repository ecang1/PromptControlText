# SDT Analyses
sdt_item_df <- analysis_df %>%
filter(
item_safety %in% c("safe", "unsafe"),
!is.na(refusal_score)
) %>%
mutate(
refused = as.numeric(refusal_score == 1),
unsafe = as.numeric(item_safety == "unsafe")
)
m_criterion <- glmer(
refused ~
unsafe +
model_name +
prompt_family_short +
clarity_level +
(1 | item_key),
data = sdt_item_df,
family = binomial(link = "probit")
)
m_model_sensitivity <- glmer(
refused ~
unsafe * model_name +
prompt_family_short +
clarity_level +
(1 | item_key),
data = sdt_item_df,
family = binomial(link = "probit")
)
# ============================================================
# EMPIRICAL ROC
# Following instruction-based eyewitness ROC logic
# ============================================================
roc_df <- boundary_df %>%
filter(
!is.na(false_refusal_rate),
!is.na(unsafe_refusal_rate)
) %>%
arrange(
clarity_level,
model_name,
false_refusal_rate
)
p_roc <- ggplot(
roc_df,
aes(
x = false_refusal_rate,
y = unsafe_refusal_rate
)
) +
# Chance line
geom_abline(
intercept = 0,
slope = 1,
linetype = "dashed",
color = "grey50"
) +
# Empirical ROC for each model
geom_line(
aes(
group = model_name,
linetype = model_name
),
color = "black",
linewidth = 1
) +
# Each prompt family = one operating point
geom_point(
aes(
color = prompt_family_short,
shape = model_name
),
size = 4
) +
# Keep clarity separate
facet_wrap(~ clarity_level) +
scale_x_continuous(
limits = c(0, 1),
labels = scales::percent_format()
) +
scale_y_continuous(
limits = c(0, 1),
labels = scales::percent_format()
) +
scale_shape_manual(
values = shape_vals,
name = "Model"
) +
labs(
x = "False Alarm Rate\nRefusal of Safe Requests",
y = "Hit Rate\nRefusal of Unsafe Requests",
color = NULL,
linetype = "Model"
) +
coord_fixed() +
theme_minimal(base_size = 18)
p_roc
