sdt_df <- analysis_df %>%
filter(
item_safety %in% c("safe", "unsafe"),
!is.na(refusal_score)
) %>%
mutate(
signal = item_safety == "unsafe",
refused = refusal_score == 1
) %>%
group_by(
model_name,
prompt_family_short,
clarity_level
) %>%
summarise(
hits = sum(signal & refused),
misses = sum(signal & !refused),
false_alarms = sum(!signal & refused),
correct_rejections = sum(!signal & !refused),
n_signal = hits + misses,
n_noise = false_alarms + correct_rejections,
.groups = "drop"
) %>%
mutate(
# Loglinear correction avoids qnorm(0) and qnorm(1)
hit_rate = (hits + 0.5) / (n_signal + 1),
false_alarm_rate = (false_alarms + 0.5) / (n_noise + 1),
z_hit = qnorm(hit_rate),
z_fa = qnorm(false_alarm_rate),
# Sensitivity
d_prime = z_hit - z_fa,
# Response criterion
criterion = -0.5 * (z_hit + z_fa),
# Equivalent AUC under equal-variance Gaussian SDT
auc = pnorm(d_prime / sqrt(2))
)
p_roc <- sdt_df %>%
filter(
!is.na(hit_rate),
!is.na(false_alarm_rate)
) %>%
ggplot(
aes(
x = false_alarm_rate,
y = hit_rate,
color = prompt_family_short,
shape = model_name
)
) +
geom_abline(
intercept = 0,
slope = 1,
linetype = "dashed",
color = "grey50"
) +
geom_point(
size = 5,
alpha = .9
) +
scale_x_continuous(
limits = c(0, 1),
labels = scales::percent_format()
) +
scale_y_continuous(
limits = c(0, 1),
labels = scales::percent_format()
) +
coord_fixed() +
labs(
x = "False Alarm Rate\nRefusal of Safe Requests",
y = "Hit Rate\nRefusal of Unsafe Requests",
color = NULL,
shape = NULL
) +
theme_minimal(base_size = 20)
p_roc
prompt_roc <- analysis_df %>%
filter(item_safety %in% c("safe", "unsafe")) %>%
group_by(model_name, prompt_family_short) %>%
summarise(
false_alarm_rate =
mean(refusal_score[item_safety == "safe"] == 1, na.rm = TRUE),
hit_rate =
mean(refusal_score[item_safety == "unsafe"] == 1, na.rm = TRUE),
.groups = "drop"
)
# Protect qnorm() from exact 0s or 1s
roc_fit_df <- prompt_roc %>%
mutate(
fa_adj  = pmin(pmax(false_alarm_rate, .001), .999),
hit_adj = pmin(pmax(hit_rate, .001), .999),
z_fa    = qnorm(fa_adj),
z_hit   = qnorm(hit_adj)
)
# Fit z(H) = a + b*z(FA) separately for each model
roc_models <- roc_fit_df %>%
group_by(model_name) %>%
group_modify(~ {
fit <- lm(z_hit ~ z_fa, data = .x)
tibble(
intercept = coef(fit)[1],
slope = coef(fit)[2]
)
}) %>%
ungroup()
roc_curves <- roc_models %>%
tidyr::crossing(
false_alarm_rate = seq(.001, .999, length.out = 500)
) %>%
mutate(
hit_rate = pnorm(
intercept +
slope * qnorm(false_alarm_rate)
)
)
p_roc_main <- ggplot(
prompt_roc,
aes(
x = false_alarm_rate,
y = hit_rate,
color = prompt_family_short,
shape = model_name
)
) +
# chance line
geom_abline(
intercept = 0,
slope = 1,
linetype = "dashed",
color = "grey50"
) +
# fitted ROC curve for each model
geom_line(
data = roc_curves,
aes(
x = false_alarm_rate,
y = hit_rate,
linetype = model_name
),
inherit.aes = FALSE,
color = "black",
linewidth = 1.2,
alpha = .8
) +
# observed prompt-family operating points
geom_point(
size = 5,
alpha = .9
) +
scale_x_continuous(
labels = scales::percent_format(accuracy = 1),
limits = c(0, 1),
expand = expansion(mult = c(.02, .02))
) +
scale_y_continuous(
labels = scales::percent_format(accuracy = 1),
limits = c(0, 1),
expand = expansion(mult = c(.02, .02))
) +
coord_fixed(ratio = 1) +
scale_shape_manual(
values = shape_vals,
name = "Model"
) +
scale_linetype_manual(
values = c("solid", "dashed", "dotdash", "dotted"),
name = "Model"
) +
labs(
x = "False Alarm Rate\nRefusal of Safe Requests",
y = "Hit Rate\nRefusal of Unsafe Requests",
color = NULL
) +
theme_minimal(base_size = 20)
p_roc_main
